# Public URL the browser uses (must match exactly for cookies/CSRF).
PUBLIC_ORIGIN=http://localhost:8088
# Caddy site address: ":80" for plain HTTP behind another proxy, or "countrybox.example.com" for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8088
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-value
