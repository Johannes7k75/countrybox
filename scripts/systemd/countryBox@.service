[Unit]
Description=CountryBox Service %i
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /home/deploy/production/countryBox/server/index.mjs
WorkingDirectory=/home/deploy/production
User=deploy
Group=deploy
Environment="PORT=%i"
Environment="NUXT_SESSION_PASSWORD=secret"
Environment="DB_URL=mysql://user:password@127.0.0.1:3306/country-box"
Restart=on-failure
TimeoutSec=30

[Install]
WantedBy=multi-user.target