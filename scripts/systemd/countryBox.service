[Unit]
Description=CountryBox Service
After=network.target

[Service]
ExecStart=/usr/bin/node /home/deploy/production/countryBox/server/index.mjs
WorkingDirectory=/home/deploy/production
User=deploy
Group=deploy
Environment="PORT=3000"
LimitNOFILE=65536
Restart=on-failure
TimeoutSec=30
PrivateTmp=true
ProtectSystem=full
ProtectHome=yes
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target