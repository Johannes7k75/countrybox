# Public URL the browser uses (must match exactly for cookies/CSRF).
PUBLIC_ORIGIN=http://localhost:8088
# Port on 127.0.0.1 for local access (Traefik reaches the container over its network instead).
HTTP_PORT=8088
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-value
# Image tag to run when using the published images (e.g. 1.0.0). Ignored with --build.
COUNTRYBOX_VERSION=latest
