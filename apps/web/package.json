{
  "name": "@countrybox/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt prepare >/dev/null && vue-tsc -b --noEmit",
    "typecheck:fast": "vue-tsc -b --noEmit",
    "postinstall": "nuxt prepare || true",
    "test": "vitest run"
  },
  "dependencies": {
    "@countrybox/api-client": "workspace:*",
    "@countrybox/catalog": "workspace:*",
    "@countrybox/contracts": "workspace:*",
    "@countrybox/domain": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@nuxtjs/i18n": "^10.6.0",
    "better-auth": "^1.7.18",
    "hono": "^4.13.16",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
